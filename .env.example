# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# Generate with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MASTER_KEY=replace-with-url-safe-base64-encoded-32-byte-key

# Keep debug disabled outside local development.
FLASK_DEBUG=0

# Set to 1 when served over HTTPS.
COOKIE_SECURE=0
